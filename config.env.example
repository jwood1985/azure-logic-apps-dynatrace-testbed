# Dynatrace OneAgent Site Extension — test bed configuration
#
# Copy to config.env and fill in real values, then: source config.env
# config.env is git-ignored so the token never lands in source control.

# --- Dynatrace tenant the OneAgent reports to ---
# DT_TENANT is the environment ID (e.g. "abc12345" for SaaS, or "abc12345" for Managed).
export DT_TENANT="qof78400"

# PaaS/API token (dt0c01....) with "InstallerDownload" permission.
export DT_API_TOKEN="dt0c01.REPLACE_ME"

# SSL verification mode for the OneAgent code module. "default" trusts the system store.
export DT_SSL_MODE="default"

# Which CLR(s) to instrument: "dotNetFramework", "dotNetCore", or "both".
export DT_MONITORED_CLR="both"

# --- Test bed scope (optional) ---
# Subscription that holds the Logic Apps (name or ID). Leave blank to scan all
# subscriptions available to the current az login.
export AZ_SUBSCRIPTION="Sales"
